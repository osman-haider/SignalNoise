# Copy this file to .env and fill in your own values.
# Nothing in this project ever hard-codes a key -- everything below is read
# from the environment at startup (see app/config.py).

# Required
OPENAI_API_KEY=sk-...

# Optional: point at an OpenAI-compatible endpoint other than api.openai.com
# (e.g. Azure OpenAI, a local proxy, etc.). Leave unset to use the default.
OPENAI_BASE_URL=

# Chat model used for query disambiguation.
OPENAI_MODEL_NAME=gpt-4o-mini

# Embedding model used for semantic re-ranking.
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Optional tuning knobs (sensible defaults are used if you leave these unset)
# ANALYST_CONTEXT=This search is for an open-source military and foreign-affairs...
# HYBRID_BM25_WEIGHT=0.4
# HYBRID_SEMANTIC_WEIGHT=0.6
# REQUEST_TIMEOUT_SECONDS=8
